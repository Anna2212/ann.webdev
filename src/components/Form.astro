---
/**
 * Форма заявки. Ловиться Netlify Forms — атрибут data-netlify.
 * Заявка зберігається в Netlify навіть якщо JavaScript вимкнено або
 * серверна функція впала. Telegram і таблиця — надбудова, не єдина точка відмови.
 */
import { CONTACTS } from '../data/site';

interface Props {
  title?: string;
  accent?: string;
  lead?: string;
  id?: string;
}

const {
  title = 'Розкажіть,',
  accent = 'що у вас за задача',
  lead = 'Подивлюсь на вашу ситуацію і скажу чесно, з чого почати. Це безкоштовно і ні до чого не зобов’язує.',
  id = 'zayavka',
} = Astro.props;

const path = Astro.url.pathname;
---

<section class="section section--wine" id={id}>
  <div class="container form-block">
    <div class="form-block__intro">
      <h2>{title} <span class="accent">{accent}</span></h2>
      <p class="lead">{lead}</p>
      <p class="hand form-block__hand" aria-hidden="true">відповідаю в той самий день</p>
    </div>

    <div class="form-block__body">
      <form
        name="zayavka"
        method="POST"
        action="/dyakuyu"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="form"
        id={`form-${id}`}
      >
        <input type="hidden" name="form-name" value="zayavka" />
        <input type="hidden" name="storinka" value={path} />
        <input type="hidden" name="dzherelo" value="" />

        <p class="form__hp">
          <label>
            Не заповнюйте це поле
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <div class="form__row">
          <label class="form__label" for={`${id}-name`}>Як до вас звертатись</label>
          <input
            class="form__input"
            type="text"
            id={`${id}-name`}
            name="imya"
            placeholder="Анна"
            required
            autocomplete="name"
          />
        </div>

        <div class="form__row">
          <label class="form__label" for={`${id}-contact`}>Куди відповісти</label>
          <input
            class="form__input"
            type="text"
            id={`${id}-contact`}
            name="kontakt"
            placeholder="+380 67 123 45 67 або @nickname"
            required
            aria-describedby={`${id}-contact-hint`}
          />
          <!-- Без підказки люди лишали щось, за чим їх не знайти -->
          <p class="form__hint" id={`${id}-contact-hint`}>
            Номер телефону, @нік у Telegram чи Instagram або пошта — головне,
            щоб я змогла вас знайти.
          </p>
        </div>

        <!-- Необовʼязкові поля згорнуті: разом вони займали 41% висоти
             форми, і чотири поля відлякували більше, ніж два. Дані ті
             самі, просто не всі одразу. details працює без JavaScript. -->
        <details class="form__more">
          <summary class="form__more-toggle">
            Додати деталі — сайт і задача
          </summary>

          <div class="form__row form__row--first">
            <label class="form__label" for={`${id}-site`}>Сайт, якщо він є</label>
            <input
              class="form__input"
              type="text"
              id={`${id}-site`}
              name="sayt"
              placeholder="annwebdev.com"
              autocomplete="url"
            />
          </div>

          <div class="form__row">
            <label class="form__label" for={`${id}-task`}>Що за задача</label>
            <textarea
              class="form__input form__input--area"
              id={`${id}-task`}
              name="zadacha"
              rows="3"
              placeholder="Коротко: чим займаєтесь і що хочете отримати"
            ></textarea>
          </div>
        </details>

        <p class="form__error" data-form-error hidden></p>

        <!-- Telegram поруч із кнопкою: для частини людей форма — це
             зобовʼязання, а месенджер ні. До цього він був тільки в
             підвалі й у липкій панелі на мобільній. -->
        <div class="form__actions">
          <button type="submit" class="btn btn--light form__submit">
            Надіслати
          </button>

          <a
            href={CONTACTS.telegram.href}
            class="btn form__telegram"
            target="_blank"
            rel="noopener"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M21.5 4.3 2.9 11.4c-.9.3-.9 1.6.1 1.9l4.6 1.4 1.8 5.4c.2.7 1.1.9 1.6.3l2.5-2.7 4.7 3.5c.6.4 1.4.1 1.6-.6l3-14.8c.2-.9-.7-1.6-1.3-1.5Z"
                fill="currentColor"></path>
            </svg>
            Написати в Telegram
          </a>
        </div>

        <p class="form__note">
          Відповідаю протягом робочого дня. Дані нікуди не передаю —
          деталі в <a href="/privacy-policy">політиці конфіденційності</a>.
        </p>
      </form>

      <div class="form__success" data-form-success hidden>
        <p class="form__success-title">Отримала.</p>
        <p>Напишу вам найближчим часом — на той контакт, який ви залишили.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .form-block {
    display: grid;
    gap: 2.5rem;
  }

  .form-block__hand {
    margin-top: 1.25rem;
    color: var(--cream-dark);
  }

  .form-block__intro .lead {
    margin-top: 1rem;
  }

  /* Поле-пастка для ботів. Прибрано з потоку, але не display:none —
     частина ботів ігнорує приховані через display */
  .form__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__row {
    margin-bottom: 1.25rem;
  }

  .form__label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--paper);
  }

  .form__optional {
    font-family: var(--font-hand);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--terracotta);
  }

  .form__input {
    width: 100%;
    /* 16px мінімум — інакше Safari зумить сторінку при фокусі */
    font-size: 16px;
    font-family: var(--font-sans);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--cream-dark);
    border-radius: var(--radius-field);
    padding: 0.9375rem 1rem;
    min-height: 52px;
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }

  .form__input::placeholder {
    color: #8B8078;
  }

  .form__input:focus {
    outline: none;
    border-color: var(--terracotta-deep);
    box-shadow: 0 0 0 1px var(--terracotta-deep);
  }

  .form__hint {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--cream-dark);
  }

  .form__input--area {
    resize: vertical;
    min-height: 104px;
    line-height: 1.5;
  }

  /* Розкривачка з необовʼязковими полями */
  .form__more {
    margin-bottom: 1.25rem;
  }

  .form__more-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--cream-dark);
    list-style: none;
    padding-block: 0.25rem;
  }

  .form__more-toggle::-webkit-details-marker {
    display: none;
  }

  /* власна стрілка, щоб не залежати від типової мітки браузера */
  .form__more-toggle::before {
    content: '';
    width: 7px;
    height: 7px;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.2s var(--ease);
  }

  .form__more[open] .form__more-toggle::before {
    transform: rotate(45deg);
  }

  .form__more-toggle:hover {
    color: var(--paper);
  }

  .form__row--first {
    margin-top: 1rem;
  }

  .form__input[aria-invalid='true'] {
    border-color: var(--terracotta);
    box-shadow: 0 0 0 1px var(--terracotta);
  }

  .form__error {
    margin: 0 0 1rem;
    font-size: var(--fs-small);
    font-weight: 700;
    color: #F0C9B4;
  }

  .form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .form__telegram {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border-color: var(--cream-dark);
    color: var(--paper);
  }

  .form__telegram:hover {
    text-decoration: none;
    background: var(--paper);
    color: var(--ink);
  }

  .form__submit[disabled] {
    opacity: 0.65;
    cursor: progress;
  }

  /* На вузькому екрані обидві кнопки на всю ширину, одна під одною */
  @media (max-width: 519px) {
    .form__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .form__telegram {
      justify-content: center;
    }
  }

  .form__note {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--cream-dark);
    max-width: 46ch;
  }

  .form__note a {
    color: var(--cream-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .form__success {
    background: rgb(251 248 243 / 0.08);
    border: 1px solid rgb(251 248 243 / 0.2);
    border-radius: var(--radius-card);
    padding: 2rem;
  }

  .form__success-title {
    font-size: var(--fs-h3);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  @media (min-width: 900px) {
    .form-block {
      grid-template-columns: 1fr 1.1fr;
      gap: 4rem;
      align-items: start;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form[name="zayavka"]').forEach((form) => {
    const wrap = form.parentElement;
    const success = wrap?.querySelector<HTMLElement>('[data-form-success]');
    const errorBox = form.querySelector<HTMLElement>('[data-form-error]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const source = form.querySelector<HTMLInputElement>('input[name="dzherelo"]');

    // Звідки прийшла людина — щоб потім бачити, які канали дають заявки
    if (source) source.value = document.referrer || 'напряму';

    let lastSent = 0;

    const showError = (text: string) => {
      if (!errorBox) return;
      errorBox.textContent = text;
      errorBox.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (errorBox) errorBox.hidden = true;
      form
        .querySelectorAll('[aria-invalid]')
        .forEach((el) => el.removeAttribute('aria-invalid'));

      // Перевірка обов'язкових полів
      const required = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        '[required]'
      );
      const empty = Array.from(required).filter((el) => !el.value.trim());

      if (empty.length) {
        empty.forEach((el) => el.setAttribute('aria-invalid', 'true'));
        empty[0].focus();
        showError('Заповніть, будь ласка, підсвічені поля.');
        return;
      }

      // Захист від подвійної відправки
      const now = Date.now();
      if (now - lastSent < 30000) {
        showError('Заявка вже пішла. Якщо треба доповнити — напишіть у Telegram.');
        return;
      }

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Надсилаю…';
      }

      try {
        const data = new FormData(form);
        const body = new URLSearchParams(data as unknown as Record<string, string>);

        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        });

        if (!response.ok) throw new Error(String(response.status));

        lastSent = now;
        form.hidden = true;
        if (success) {
          success.hidden = false;
          success.setAttribute('tabindex', '-1');
          success.focus();
        }
      } catch {
        showError(
          'Не вдалося надіслати. Спробуйте ще раз або напишіть у Telegram @anna_medvid.'
        );
        if (submit) {
          submit.disabled = false;
          submit.textContent = 'Надіслати';
        }
      }
    });
  });
</script>
