---
import type { CaseItem } from '../data/cases';

interface Props {
  item: CaseItem;
  /** На картці головної показуємо довший опис, на списку — короткий рядок */
  variant?: 'card' | 'line';
}

const { item, variant = 'card' } = Astro.props;
const text = variant === 'card' ? item.card : item.line;
---

<a href={`/keysy/${item.slug}`} class="case card">
  <div class="case__media">
    <img
      src={item.image}
      alt={`Сайт проєкту ${item.title}`}
      width="1200"
      height="800"
      loading="lazy"
    />
    {item.note && <span class="case__note">{item.note}</span>}
  </div>

  <div class="case__body">
    <p class="kicker">{item.kicker}</p>
    <h3 class="case__title">{item.title}</h3>
    <p class="case__text">{text}</p>
  </div>

  <span class="case__arrow" aria-hidden="true">
    <svg width="20" height="14" viewBox="0 0 20 14" fill="none">
      <path
        d="M1 7h17m0 0-6-6m6 6-6 6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</a>

<style>
  .case {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }

  .case__media {
    position: relative;
    aspect-ratio: 3 / 2;
    background: var(--cream-dark);
    overflow: hidden;
  }

  .case__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .case:hover .case__media img {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .case:hover .case__media img { transform: none; }
  }

  .case__note {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-start: 0.75rem;
    background: var(--ink-soft);
    color: var(--paper);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.375rem 0.625rem;
    border-radius: 999px;
  }

  .case__body {
    padding: 1.25rem 1.25rem 3.25rem;
    flex: 1;
  }

  .case__title {
    margin-block: 0.5rem 0.625rem;
    font-size: 1.375rem;
  }

  .case__text {
    color: var(--ink-soft);
    font-size: var(--fs-small);
    line-height: 1.6;
    margin: 0;
  }

  .case__arrow {
    position: absolute;
    inset-block-end: 1.25rem;
    inset-inline-end: 1.25rem;
    color: var(--terracotta-deep);
    transition: transform 0.2s var(--ease);
  }

  .case:hover .case__arrow {
    transform: translateX(4px);
  }

  @media (min-width: 768px) {
    .case__body {
      padding: 1.5rem 1.5rem 3.5rem;
    }
  }
</style>
