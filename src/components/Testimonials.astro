---
/**
 * Відгуки клієнтів.
 *
 * Один відгук — широка картка на два стовпці: зліва скрін оригінального
 * повідомлення (доказ, що відгук справжній), справа текст. Без скріна
 * картка займає ту саму ширину, просто без лівого стовпця.
 * Коли відгуків стане кілька, картки стануть одна під одною.
 *
 * Без відгуків не рендериться взагалі.
 *
 * items    — які відгуки показати (за замовчуванням усі)
 * tone     — фон секції, щоб вписатись у чергування paper/cream сторінки
 * withCase — показувати посилання на кейс під цитатою (на сторінці самого
 *            кейса воно зайве)
 */
import { TESTIMONIALS, type Testimonial } from '../data/testimonials';
import { CASES } from '../data/cases';

interface Props {
  items?: Testimonial[];
  tone?: 'paper' | 'cream';
  withCase?: boolean;
  kicker?: string;
  title?: string;
}

const {
  items = TESTIMONIALS,
  tone = 'cream',
  withCase = true,
  kicker = 'відгуки',
  title = 'Що кажуть клієнти',
} = Astro.props;

const caseFor = (slug?: string) => CASES.find((c) => c.slug === slug);
---

{
  items.length > 0 && (
    <section class:list={['section', `section--${tone}`, 'testimonials']}>
      <div class="container">
        <p class="kicker kicker--line reveal">{kicker}</p>
        <h2 class="reveal h--quiet testimonials__title">{title}</h2>

        <div class="testimonials__list reveal-group">
          {items.map((t) => {
            const item = caseFor(t.caseSlug);
            const shot = t.screenshot;
            return (
              <figure class:list={['testimonial', { 'testimonial--with-shot': !!shot }]}>
                {shot && (
                  <div class="testimonial__shot">
                    <img
                      src={`/images/${shot.name}.webp`}
                      srcset={`/images/${shot.name}.webp 1x, /images/${shot.name}@2x.webp 2x`}
                      alt={shot.alt}
                      width={shot.width}
                      height={shot.height}
                      loading="lazy"
                      decoding="async"
                    />
                    <p class="testimonial__shot-note text-soft">Оригінал повідомлення</p>
                  </div>
                )}

                <div class="testimonial__body">
                  <blockquote class="testimonial__quote">
                    {t.quote.map((p) => (
                      <p>{p}</p>
                    ))}
                  </blockquote>
                  <figcaption class="testimonial__meta">
                    <span class="testimonial__author">
                      {t.author}, {t.company}
                    </span>
                    {withCase && item && (
                      <a class="testimonial__case" href={`/keysy/${item.slug}`}>
                        Дивитись кейс
                      </a>
                    )}
                  </figcaption>
                </div>
              </figure>
            );
          })}
        </div>
      </div>
    </section>
  )
}

<style>
  /* Відступи заголовка і списку — свої, бо stack-sm / stack-top описані
     в стилях сторінок і всередині компонента не діють */
  .testimonials__title {
    margin-block-start: 1rem;
  }

  .testimonials__list {
    display: grid;
    gap: 1.5rem;
    margin-block-start: 2.5rem;
  }

  .testimonial {
    margin: 0;
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--paper);
    border: 1px solid var(--cream-dark);
    border-radius: var(--radius-card);
  }

  .section--paper .testimonial {
    background: var(--cream);
  }

  .testimonial__body {
    position: relative;
    padding-block-start: 2rem;
  }

  /* Велика лапка в Playfair — той самий прийом, що акценти в заголовках */
  .testimonial__body::before {
    content: '“';
    position: absolute;
    inset-block-start: -0.75rem;
    inset-inline-start: -0.25rem;
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 1;
    color: var(--terracotta);
    opacity: 0.55;
    pointer-events: none;
  }

  .testimonial__quote {
    margin: 0;
    max-width: 62ch;
    line-height: 1.6;
  }

  .testimonial__quote p {
    margin: 0;
  }

  .testimonial__quote p + p {
    margin-block-start: 0.875rem;
  }

  .testimonial__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    margin-block-start: 1.5rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--cream-dark);
    font-size: var(--fs-small);
  }

  .testimonial__author {
    font-weight: 700;
  }

  .testimonial__case {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Скрін: як фото повідомлення на телефоні, з рамкою і легкою тінню */
  .testimonial__shot {
    max-width: 340px;
  }

  .testimonial__shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--cream-dark);
    box-shadow: 0 10px 30px rgb(36 28 22 / 0.12);
    background: var(--cream-dark);
  }

  .testimonial__shot-note {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
  }

  @media (min-width: 900px) {
    .testimonial {
      padding: 2.5rem;
    }

    .testimonial--with-shot {
      grid-template-columns: minmax(260px, 340px) 1fr;
      gap: 3rem;
      align-items: start;
    }

    .testimonial__body {
      padding-block-start: 2.25rem;
    }
  }
</style>
