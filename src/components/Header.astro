---
import Logo from './Logo.astro';
import { NAV } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header" id="site-header">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="На головну">
      <Logo height={32} />
    </a>

    <nav class="header__nav" aria-label="Основне меню">
      <ul class="header__list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['header__link', { 'is-current': path === item.href }]}
                aria-current={path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/#zayavka" class="btn btn--primary btn--sm header__cta">
      Безкоштовний розбір
    </a>

    <button
      type="button"
      class="header__burger"
      id="burger"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Відкрити меню</span>
      <span class="header__burger-line"></span>
      <span class="header__burger-line"></span>
    </button>
  </div>

  <div class="header__mobile" id="mobile-menu" hidden>
    <nav class="container" aria-label="Меню на мобільній">
      <ul class="header__mobile-list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="header__mobile-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(251 248 243 / 0.96);
    backdrop-filter: saturate(140%) blur(6px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--ease);
  }

  .header.is-scrolled {
    border-bottom-color: var(--cream-dark);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 68px;
  }

  .header__logo {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
  }

  .header__nav {
    display: none;
    margin-inline-start: auto;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .header__link {
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 700;
    padding-block: 0.5rem;
    border-bottom: 2px solid transparent;
  }

  .header__link:hover {
    text-decoration: none;
    border-bottom-color: var(--terracotta);
  }

  .header__link.is-current {
    border-bottom-color: var(--terracotta);
  }

  .header__cta {
    display: none;
    flex: 0 0 auto;
  }

  /* Бургер */
  .header__burger {
    margin-inline-start: auto;
    width: 44px;
    height: 44px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .header__burger-line {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
  }

  .header__burger[aria-expanded='true'] .header__burger-line:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .header__burger[aria-expanded='true'] .header__burger-line:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .header__mobile {
    border-top: 1px solid var(--cream-dark);
    padding-block: 0.75rem 1.25rem;
    background: var(--paper);
  }

  .header__mobile-list {
    display: flex;
    flex-direction: column;
  }

  .header__mobile-link {
    display: block;
    padding: 0.875rem 0;
    color: var(--ink);
    font-weight: 700;
    border-bottom: 1px solid var(--cream-dark);
  }

  .header__mobile-link:hover {
    text-decoration: none;
    color: var(--terracotta-deep);
  }

  @media (min-width: 1024px) {
    .header__inner {
      min-height: 80px;
      gap: 2rem;
    }
    .header__nav,
    .header__cta {
      display: block;
    }
    .header__burger,
    .header__mobile {
      display: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');

  if (burger && menu) {
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      menu.hidden = open;
    });
  }

  if (header) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
