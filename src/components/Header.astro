---
import Logo from './Logo.astro';
import { NAV } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header" id="site-header">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="На головну">
      <Logo height={32} />
    </a>

    <nav class="header__nav" aria-label="Основне меню">
      <ul class="header__list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['header__link', { 'is-current': path === item.href }]}
                aria-current={path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/#zayavka" class="btn btn--primary btn--sm header__cta">
      Безкоштовний розбір
    </a>

    <!-- Назва в aria-label, а не окремим span: інакше він стає першим
         дочірнім елементом і ламає :first-child у стилях хрестика.
         Стан «відкрито/закрито» читалка бере з aria-expanded. -->
    <button
      type="button"
      class="header__burger"
      id="burger"
      aria-label="Меню"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="header__burger-line"></span>
      <span class="header__burger-line"></span>
    </button>
  </div>

  <div class="header__mobile" id="mobile-menu" hidden>
    <nav class="container" aria-label="Меню на мобільній">
      <ul class="header__mobile-list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="header__mobile-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    --header-h: 68px;
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(251 248 243 / 0.96);
    backdrop-filter: saturate(140%) blur(6px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--ease);
  }

  .header.is-scrolled {
    border-bottom-color: var(--cream-dark);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-h);
  }

  .header__logo {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
  }

  .header__nav {
    display: none;
    margin-inline-start: auto;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .header__link {
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 700;
    padding-block: 0.5rem;
    border-bottom: 2px solid transparent;
  }

  .header__link:hover {
    text-decoration: none;
    border-bottom-color: var(--terracotta);
  }

  .header__link.is-current {
    border-bottom-color: var(--terracotta);
  }

  .header__cta {
    display: none;
    flex: 0 0 auto;
  }

  /* Бургер */
  .header__burger {
    margin-inline-start: auto;
    width: 44px;
    height: 44px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .header__burger-line {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
  }

  .header__burger[aria-expanded='true'] .header__burger-line:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .header__burger[aria-expanded='true'] .header__burger-line:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* Панель на весь екран під шапкою: поки меню відкрите, до сторінки
     під ним не можна ні дотягнутись кліком, ні доскролити */
  .header__mobile {
    position: fixed;
    inset-block-start: var(--header-h);
    inset-inline: 0;
    /* Висота задана явно, а не через bottom: 0. Шапка має backdrop-filter,
       через що вона стає containing block для fixed-нащадків, і відлік
       від низу йшов би від низу шапки, а не екрана. */
    height: calc(100vh - var(--header-h));
    height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px solid var(--cream-dark);
    padding-block: 0.75rem 1.25rem;
    background: var(--paper);
  }

  :global(body.is-menu-open) {
    overflow: hidden;
  }

  .header__mobile-list {
    display: flex;
    flex-direction: column;
  }

  .header__mobile-link {
    display: block;
    padding: 0.875rem 0;
    color: var(--ink);
    font-weight: 700;
    border-bottom: 1px solid var(--cream-dark);
  }

  .header__mobile-link:hover {
    text-decoration: none;
    color: var(--terracotta-deep);
  }

  @media (min-width: 1024px) {
    .header {
      --header-h: 80px;
    }
    .header__inner {
      gap: 2rem;
    }
    .header__nav,
    .header__cta {
      display: block;
    }
    .header__burger,
    .header__mobile {
      display: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');

  if (burger && menu) {
    const setMenu = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      // блокує скрол сторінки під відкритим меню
      document.body.classList.toggle('is-menu-open', open);
    };

    burger.addEventListener('click', () => {
      setMenu(burger.getAttribute('aria-expanded') !== 'true');
    });

    // Escape закриває меню і повертає фокус на кнопку
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        burger.focus();
      }
    });

    // Клік по пункту меню веде на іншу сторінку — знімаємо замок,
    // щоб він не лишився, якщо браузер поверне сторінку з кешу
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setMenu(false);
    });
  }

  if (header) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
