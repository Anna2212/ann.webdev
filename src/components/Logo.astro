---
/**
 * Логотип-лок-ап: знак-монограма (SVG) + текст ANN.WEBDEV (звичайний HTML).
 *
 * Текст навмисно НЕ всередині SVG: у SVG його ширина залежить від метрик
 * шрифту, і коли підвантажується Montserrat, напис ставав ширшим за viewBox
 * і остання літера обрізалась. HTML-текст просто не може обрізатись.
 *
 * variant: 'dark'  — текст Ink, для світлого фону
 *          'light' — текст Paper, для темного фону
 * mark: true — тільки знак без тексту, для вузьких місць
 * height — розмір знака в px, решта масштабується від нього
 */
interface Props {
  variant?: 'dark' | 'light';
  mark?: boolean;
  height?: number;
  class?: string;
}

const {
  variant = 'dark',
  mark = false,
  height = 34,
  class: className = '',
} = Astro.props;

const label = 'ann.webdev — Анна Медвідь, веброзробниця';
---

<span
  class:list={['logo', `logo--${variant}`, className]}
  style={`--logo-h: ${height}px`}
>
  <svg
    class="logo__mark"
    viewBox="0 0 34 34"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role={mark ? 'img' : undefined}
    aria-label={mark ? label : undefined}
    aria-hidden={mark ? undefined : 'true'}
  >
    <rect width="34" height="34" rx="8" fill="#C6673B"></rect>
    <text
      x="17"
      y="24.5"
      text-anchor="middle"
      font-family="'Playfair Display', Georgia, serif"
      font-style="italic"
      font-size="22"
      fill="#FBF8F3">a</text
    >
  </svg>

  {
    !mark && (
      <span class="logo__text">
        ANN<span class="logo__dot">.</span>WEBDEV
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo-h) * 0.41);
    line-height: 1;
  }

  .logo__mark {
    display: block;
    flex: 0 0 auto;
    width: var(--logo-h);
    height: var(--logo-h);
  }

  .logo__text {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: calc(var(--logo-h) * 0.5);
    letter-spacing: 0.1em;
    /* компенсуємо трекінг праворуч від останньої літери */
    margin-inline-end: -0.1em;
    white-space: nowrap;
  }

  .logo--dark .logo__text {
    color: var(--ink);
  }

  .logo--light .logo__text {
    color: var(--paper);
  }

  .logo__dot {
    color: var(--terracotta);
  }
</style>
