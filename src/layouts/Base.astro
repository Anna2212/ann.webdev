---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import CookieConsent from '../components/CookieConsent.astro';
import ExitIntent from '../components/ExitIntent.astro';
import { SITE, ALLOW_INDEXING } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Шлях без домену, наприклад '/poslugy' */
  path: string;
  ogImage?: string;
  /** Готовий об'єкт schema.org для цієї сторінки */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = '/og-default.svg',
  schema,
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE.url).href;
const ogUrl = new URL(ogImage, SITE.url).href;
const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      (noindex || !ALLOW_INDEXING) && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FBF8F3" />

    <link rel="sitemap" href="/sitemap.xml" />

    {/*
      Блоки з появою при скролі стартують з opacity: 0, а показує їх
      JavaScript. Без нього сторінка лишилась би порожньою нижче першого
      екрана — не «без анімації», а зовсім без тексту. Тут показуємо все
      одразу. З увімкненим JS браузер цей тег навіть не читає.
    */}
    <noscript>
      <style>
        .reveal,
        .reveal-group > *,
        .reveal-lines .line {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    {
      schemaList.map((item) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(item)}
        />
      ))
    }
  </head>

  <body>
    <a href="#main" class="skip-link">Перейти до вмісту</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyCta />
    <CookieConsent />
    <ExitIntent />

    <script>
      // Чи просив користувач менше руху — тоді нічого не анімуємо
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // --- Поява при скролі: окремі блоки і групи ---
      const revealables = document.querySelectorAll(
        '.reveal, .reveal-group, .reveal-lines'
      );

      if (revealables.length) {
        if (calm) {
          revealables.forEach((el) => el.classList.add('is-visible'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
          );
          revealables.forEach((el) => io.observe(el));
        }
      }

      // --- Таймлайн: лінія промальовується разом зі скролом ---
      const timeline = document.querySelector<HTMLElement>('.timeline');

      if (timeline && !calm) {
        const items = Array.from(timeline.querySelectorAll('li'));

        const drawLine = () => {
          const rect = timeline.getBoundingClientRect();
          const anchor = window.innerHeight * 0.62;
          const passed = anchor - rect.top;
          const progress = Math.max(0, Math.min(1, passed / rect.height));
          timeline.style.setProperty('--progress', String(progress));

          items.forEach((item) => {
            const box = item.getBoundingClientRect();
            item.classList.toggle('is-active', box.top < anchor);
          });
        };

        drawLine();
        window.addEventListener('scroll', drawLine, { passive: true });
        window.addEventListener('resize', drawLine, { passive: true });
      }

      // --- Цифри в блоці довіри набігають один раз ---
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');

      if (counters.length && !calm) {
        const runCounter = (el: HTMLElement) => {
          const target = Number(el.dataset.count || '0');
          const suffix = el.dataset.suffix || '';
          const duration = 900;
          const start = performance.now();

          const tick = (now: number) => {
            const time = Math.min(1, (now - start) / duration);
            // сповільнення наприкінці, щоб не смикалось
            const eased = 1 - Math.pow(1 - time, 3);
            el.textContent = Math.round(target * eased) + suffix;
            if (time < 1) requestAnimationFrame(tick);
          };

          requestAnimationFrame(tick);
        };

        const counterObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                runCounter(entry.target as HTMLElement);
                counterObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.6 }
        );

        counters.forEach((el) => counterObserver.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--ink);
    color: var(--paper);
    padding: 0.75rem 1.25rem;
    border-radius: 0 0 var(--radius-field) 0;
  }

  .skip-link:focus {
    left: 0;
  }
</style>
