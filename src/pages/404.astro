---
import Base from '../layouts/Base.astro';
---

<Base
  title="Сторінку не знайдено | annwebdev.com"
  description="Такої сторінки немає. Можливо, вона переїхала або в адресі помилка."
  path="/404"
  noindex={true}
>
  <section class="section section--paper section--hero">
    <div class="container notfound">
      <p class="kicker">помилка 404</p>
      <h1 class="notfound__title">
        Такої сторінки немає.<br />
        <span class="accent">Але є інші</span>
      </h1>
      <p class="lead notfound__lead">
        Можливо, сторінка переїхала або в адресі загубилась літера. Ось куди
        можна піти замість неї.
      </p>

      <div class="notfound__actions">
        <a href="/" class="btn btn--primary btn--block-mobile">На головну</a>
        <a href="/keysy" class="btn btn--secondary btn--block-mobile">
          Подивитись кейси
        </a>
      </div>

      <ul class="notfound__links">
        <li><a href="/poslugy">Послуги і умови роботи</a></li>
        <li><a href="/pro-mene">Про мене</a></li>
        <li><a href="/faq">Питання і відповіді</a></li>
        <li><a href="/kontakty">Контакти</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .notfound {
    max-width: 42rem;
  }

  .notfound__title {
    margin-top: 1rem;
  }

  .notfound__lead {
    margin-top: 1.5rem;
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .notfound__links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--cream-dark);
    font-size: var(--fs-small);
  }
</style>
