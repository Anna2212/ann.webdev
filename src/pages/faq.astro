---
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
import Accordion from '../components/Accordion.astro';
import { FAQ_GROUPS, FAQ_FLAT } from '../data/faq';
import { CONTACTS } from '../data/site';

const title = 'Питання і відповіді про розробку сайтів | Анна Медвідь';
const description =
  'Скільки триває розробка сайту, чому передоплата 50%, що входить у вартість, чи можна вносити правки самостійно. Відповідаю прямо, без загальних фраз.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_FLAT.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a.join(' '),
    },
  })),
};
---

<Base title={title} description={description} path="/faq" schema={schema}>
  <section class="section section--paper">
    <div class="container">
      <p class="kicker">питання і відповіді</p>
      <h1 class="faq-title">
        Питання, які мені ставлять <span class="accent">найчастіше</span>
      </h1>
      <p class="lead faq-lead">
        Якщо вашого питання тут немає — напишіть у
        <a href={CONTACTS.telegram.href} target="_blank" rel="noopener">Telegram</a>,
        відповім особисто.
      </p>

      {
        FAQ_GROUPS.map((group, index) => (
          <section class="faq-group">
            <h2 class="faq-group__title">{group.title}</h2>
            <Accordion items={group.items} openFirst={index === 0} />
          </section>
        ))
      }
    </div>
  </section>

  <Form
    title="Не знайшли відповідь?"
    accent="Спитайте напряму"
    lead="Опишіть свою ситуацію — подивлюсь і скажу чесно, з чого почати. Це безкоштовно і ні до чого не зобов’язує."
  />
</Base>

<style>
  .faq-title {
    margin-block: 1rem 1.25rem;
  }

  .faq-lead {
    margin-bottom: 3rem;
  }

  .faq-group + .faq-group {
    margin-top: 3.5rem;
  }

  .faq-group__title {
    font-size: var(--fs-h3);
    margin-bottom: 1.25rem;
  }
</style>
