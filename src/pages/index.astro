---
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
import CaseCard from '../components/CaseCard.astro';
import Photo from '../components/Photo.astro';
import { CTA, SITE, CONTACTS } from '../data/site';
import { PAINS, SERVICES, STEPS, FACTS } from '../data/home';
import { FEATURED_CASES } from '../data/cases';

const title = 'Анна Медвідь - конверсійні сайти й Telegram-боти для бізнесу';
const description =
  'Роблю сайти, які приводять заявки, а не просто висять в інтернеті. Аналіз ніші, конверсійна структура, тексти, чат-боти. 5 років у frontend-розробці. Безкоштовний розбір вашого сайту.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Анна Медвідь',
    alternateName: 'Anna Medvid',
    jobTitle: 'Веброзробниця',
    description:
      'Українська веброзробниця. Створює конверсійні сайти та Telegram-боти для малого й середнього бізнесу.',
    url: SITE.url,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Тернопіль',
      addressCountry: 'UA',
    },
    email: CONTACTS.email.label,
    telephone: '+380685935456',
    knowsAbout: [
      'Розробка сайтів',
      'Конверсійна структура сайту',
      'Telegram-боти',
      'Автоматизація бізнес-процесів',
      'SEO',
    ],
    sameAs: [CONTACTS.instagram.href, CONTACTS.channel.href],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Анна Медвідь — розробка сайтів і чат-ботів',
    description:
      'Конверсійні сайти, інтернет-магазини на no-code і Telegram-боти для українського малого та середнього бізнесу.',
    url: SITE.url,
    areaServed: { '@type': 'Country', name: 'Україна' },
    telephone: '+380685935456',
    email: CONTACTS.email.label,
    priceRange: '$$',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'annwebdev.com',
    url: SITE.url,
    inLanguage: 'uk',
  },
];
---

<Base title={title} description={description} path="/" schema={schema}>
  <!-- Блок 2. Перший екран -->
  <section class="section section--paper section--hero grid-bg">
    <div class="container hero">
      <div class="hero__text">
        <p class="kicker kicker--line reveal">розробка сайтів для бізнесу</p>
        <h1 class="reveal-lines hero__title">
          <span class="line">Сайт має приводити заявки,</span>
          <span class="line accent">а не висіти в інтернеті</span>
        </h1>
        <p class="lead hero__lead">
          Роблю конверсійні сайти й Telegram-боти для українського малого та
          середнього бізнесу. Починаю не з дизайну, а з логіки: розбираю нішу,
          конкурентів і аудиторію, будую структуру, яка веде людину до заявки.
        </p>
        <div class="hero__actions">
          <a href={CTA.anchor} class="btn btn--primary btn--block-mobile">
            {CTA.primary}
          </a>
          <a href="/keysy" class="btn btn--secondary btn--block-mobile">
            Подивитись кейси
          </a>
        </div>
      </div>

      <div class="hero__media framed">
        <Photo
          name="stairs"
          alt="Анна Медвідь сидить на сходах з ноутбуком у руках"
          priority={true}
          sizes="(min-width: 900px) 42vw, 100vw"
        />
      </div>
    </div>
  </section>

  <!-- Блок 3. Впізнаєте свою ситуацію -->
  <section class="section section--cream section--tight">
    <div class="container">
      <p class="kicker kicker--line reveal">знайомі ситуації</p>
      <h2 class="reveal stack-sm h--quiet">
        Найчастіше до мене приходять <span class="accent">ось з цим</span>
      </h2>
      <div class="grid grid--2 stack-top reveal-group pain-list">
        {
          PAINS.map((item) => (
            <article class="pain">
              <span class="pain__mark" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path
                    d="M1 1l12 12M13 1L1 13"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                  />
                </svg>
              </span>
              <h3 class="mini__title">{item.title}</h3>
              <p class="text-soft mini__text">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Блок 4. Що я роблю -->
  <section class="section section--paper">
    <div class="container">
      <p class="kicker kicker--line reveal">напрямки роботи</p>
      <h2 class="reveal stack-sm h--quiet">Що я роблю</h2>
      <p class="lead stack-sm reveal">
        Інструмент обираю під задачу, а не навпаки. Десь швидше й дешевше зібрати
        на конструкторі, десь без коду не обійтись — я вмію обидва варіанти, тому
        не змушую вас підлаштовувати задачу під платформу.
      </p>

      <div class="grid grid--2 stack-top reveal-group">
        {
          SERVICES.map((item) => (
            <article class="card">
              <h3 class="mini__title">{item.title}</h3>
              <p class="text-soft mini__text">{item.text}</p>
            </article>
          ))
        }
      </div>

      <div class="center-actions">
        <a href={CTA.anchor} class="btn btn--primary btn--block-mobile">
          {CTA.primary}
        </a>
        <p class="center-actions__note">
          <a href="/poslugy">Докладніше про послуги і умови</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Блок 5. Як я працюю -->
  <section class="section section--cream section--roomy">
    <div class="container process">
      <div class="process__text">
        <p class="kicker kicker--line reveal">як влаштована робота</p>
        <h2 class="reveal stack-sm">
          Спочатку логіка, <span class="accent">потім дизайн</span>
        </h2>
        <p class="lead stack-sm reveal">
          Найчастіша помилка — почати з красивої картинки і потім вписувати в неї
          сенс. Я роблю навпаки, і саме через це сайт у результаті працює.
        </p>

        <ol class="steps timeline stack-top">
          {
            STEPS.map((step) => (
              <li class="step">
                <span class="badge-num">{step.num}</span>
                <div>
                  <h3 class="step__title">{step.title}</h3>
                  <p class="text-soft step__text">{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <p class="stack-sm">
          <a href="/poslugy">Усі сім кроків — на сторінці послуг</a>
        </p>
      </div>

      <div class="process__media zoom-wrap">
        <Photo
          name="process"
          alt="Анна за роботою: руки на клавіатурі ноутбука, телефон поруч"
          sizes="(min-width: 900px) 32vw, 100vw"
        />
      </div>
    </div>
  </section>

  <!-- Блок 6. Кейси -->
  <section class="section section--paper section--roomy">
    <div class="container">
      <p class="kicker kicker--line reveal">кейси</p>
      <h2 class="reveal stack-sm h--lead">
        Різні ніші, <span class="accent">один підхід</span>
      </h2>
      <p class="lead stack-sm reveal">
        Нижче три проєкти, які найкраще показують, як це працює. Решту можна
        подивитись у повному портфоліо.
      </p>

      <div class="grid grid--3 stack-top reveal-group">
        {FEATURED_CASES.map((item) => <CaseCard item={item} />)}
      </div>

      <p class="stack-sm">
        <a href="/keysy">Усі проєкти</a>
      </p>
    </div>
  </section>

  <!-- Блок 7. Чому мені можна довіряти -->
  <!-- Темна смуга посеред сторінки: єдиний злам у чергуванні paper/cream,
       щоб око мало за що зачепитись до самої форми -->
  <section class="section section--ink section--tight">
    <div class="container">
      <p class="kicker kicker--line reveal">точки довіри</p>
      <h2 class="reveal stack-sm h--quiet">Чому мені можна довіряти</h2>
      <div class="grid grid--4 stack-top reveal-group">
        {
          FACTS.map((fact) => (
            <div class="fact">
              <p class="fact__lead">
                {
                  'count' in fact ? (
                    <span data-count={fact.count} data-suffix={fact.suffix}>
                      0{fact.suffix}
                    </span>
                  ) : (
                    fact.lead
                  )
                }
              </p>
              <h3 class="fact__title">{fact.title}</h3>
              <p class="text-soft fact__text">{fact.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Блок 8. Коротко про мене -->
  <section class="section section--paper">
    <div class="container about">
      <div class="about__media framed">
        <Photo
          name="portrait"
          alt="Портрет Анни Медвідь"
          sizes="(min-width: 900px) 34vw, 100vw"
        />
      </div>

      <div class="about__text">
        <h2>Привіт, я Анна</h2>
        <div class="about__body prose stack-sm">
          <p>
            Я двічі починала займатися розробкою сайтів, і обидва рази це було
            десь від безвиході, напевно. Перший раз — у 2016-му, коли страшно
            хотілось в айті: купила курси з фронтенду і сиділа за кодом з десятої
            ранку до десятої вечора кожного дня, десь цілий рік.
          </p>
          <p>
            Потім було п’ять років у наймі, вигорання і пауза. А коли повернулась
            — уже через конструктори, і на другому тижні навчання був урок про
            структуру сайту, про те, як сторінка веде людину до конкретної дії.
            Сиділа й думала: блін, це ж так логічно, чому раніше про це взагалі
            не думала.
          </p>
          <p>
            Зараз роблю сайти й чат-боти для бізнесу. Знаходжусь у Тернополі,
            працюю онлайн — і мені не має значення, у якій точці світу ви
            знаходитесь.
          </p>
        </div>
        <p class="stack-sm">
          <a href="/pro-mene">Моя історія повністю</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Блок 9. Відгуки — структурно передбачений, вмикається з першими відгуками -->

  <!-- Блок 10. Форма -->
  <Form />
</Base>

<style>
  .stack-sm {
    margin-top: 1rem;
  }

  .hero__title {
    margin-top: 1.25rem;
  }

  /* Болі — список з лінійками, а не картки. Поруч із картками послуг
     дві однакові сітки коробок читались як один довгий блок, до того ж
     цей розділ допоміжний і не має важити стільки ж, скільки послуги. */
  .pain-list {
    row-gap: 0;
  }

  .pain {
    position: relative;
    border-block-start: 1px solid var(--cream-dark);
    padding: 1.5rem 2.25rem 1.75rem 0;
  }

  .pain__mark {
    position: absolute;
    inset-block-start: 1.75rem;
    inset-inline-end: 0.25rem;
    color: var(--terracotta);
    opacity: 0.55;
  }

  .mini__title {
    padding-inline-end: 1.75rem;
  }
  .stack-top {
    margin-top: 2.5rem;
  }

  /* Перший екран */
  .hero {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .hero__lead {
    margin-top: 1.5rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

    /* Дрібні картки: болі й послуги */
  .mini__title {
    font-size: 1.25rem;
  }

  .mini__text {
    margin-top: 0.625rem;
    font-size: var(--fs-small);
  }

  .center-actions {
    margin-top: 2.5rem;
    text-align: center;
  }

  .center-actions__note {
    margin-top: 1rem;
    font-size: var(--fs-small);
  }

  /* Процес */
  .process {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .step {
    display: flex;
    gap: 1rem;
  }

  .step__title {
    font-size: 1.125rem;
  }

  .step__text {
    margin-top: 0.375rem;
    font-size: var(--fs-small);
  }

    /* Факти довіри */
  .fact__lead {
    font-weight: 900;
    font-size: 2rem;
    line-height: 1;
    color: var(--terracotta);
    margin: 0;
  }

  /* На темному базова теракота дає замалий контраст */
  .section--ink .fact__lead {
    color: var(--terracotta-light);
  }

  .fact__title {
    font-size: 1rem;
    margin-top: 0.5rem;
  }

  .fact__text {
    margin-top: 0.625rem;
    font-size: var(--fs-small);
  }

  /* Коротко про мене */
  .about {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

    /* Sage як тонкий акцент — єдине місце на головній */
  .about__body {
    border-inline-start: 2px solid var(--sage);
    padding-inline-start: 1.25rem;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
    }
    .process {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 4rem;
    }
    .about {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 3.5rem;
    }
    .process__media {
      position: sticky;
      top: 100px;
    }
  }
</style>
