---
import Base from '../../layouts/Base.astro';
import Form from '../../components/Form.astro';
import CaseCard from '../../components/CaseCard.astro';
import { CASES } from '../../data/cases';
import { SITE } from '../../data/site';

const title = 'Кейси - сайти й боти для українського бізнесу | Анна Медвідь';
const description =
  'Проєкти в різних нішах: реабілітація, туризм, кар’єрне консультування, флористика, освіта. Кожен сайт можна відкрити і подивитись, як він працює.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Кейси',
  description,
  url: `${SITE.url}/keysy`,
  inLanguage: 'uk',
  hasPart: CASES.map((item) => ({
    '@type': 'CreativeWork',
    name: item.title,
    url: `${SITE.url}/keysy/${item.slug}`,
    abstract: item.line,
  })),
};
---

<Base title={title} description={description} path="/keysy" schema={schema}>
  <section class="section section--paper section--hero">
    <div class="container">
      <p class="kicker">портфоліо</p>
      <h1 class="page-title">Проєкти</h1>
      <p class="lead stack-sm">
        Різні ніші, різні платформи, один підхід: спершу розібратись, кого і куди
        ми ведемо, і тільки потім будувати. Кожен сайт можна відкрити і
        подивитись, як він працює зараз.
      </p>

      <div class="grid grid--3 stack-top reveal-group">
        {CASES.map((item) => <CaseCard item={item} variant="line" />)}
      </div>
    </div>
  </section>

  <Form />
</Base>

<style>
  .page-title {
    margin-top: 1rem;
  }
  .stack-sm {
    margin-top: 1.25rem;
  }
  .stack-top {
    margin-top: 3rem;
  }
</style>
